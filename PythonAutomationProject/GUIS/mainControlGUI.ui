  <property name="styleSheet">
   <string notr="true">/* =========================
   GLOBAL
   ========================= */

QWidget {
    background-color: #141416;
    color: #dddddf;
    font-family: &quot;Segoe UI&quot;;
    font-size: 10pt;
}


/* =========================
   FRAMES / CONTAINERS
   ========================= */

QFrame {
    background-color: #1b1b1e;
    border: none;
}

QGroupBox {
    background-color: #1b1b1e;
    color: #dddddf;
    border: none;
    border-radius: 6px;
    margin-top: 12px;
    padding: 12px;
}

QGroupBox::title {
    color: #d65353;
    background-color: #1b1b1e;
    padding: 0 6px;
}


/* =========================
   LABELS
   ========================= */

QLabel {
    background-color: transparent;
    color: #d5d5d8;
}

QLabel#title {
    color: #e8e8ea;
    font-size: 20pt;
    font-weight: bold;
}

QLabel#subtitle {
    color: #88888e;
}


/* =========================
   BUTTONS
   ========================= */

QPushButton {
    background-color: #252528;
    color: #d7d7da;
    border: none;
    border-radius: 5px;
    padding: 8px 12px;
}

QPushButton:hover {
    background-color: #303034;
    color: #f0f0f0;
}

QPushButton:pressed {
    background-color: #3b2222;
}

QPushButton:checked {
    background-color: #5b2929;
    color: #ffffff;
}

QPushButton:disabled {
    background-color: #202023;
    color: #5f5f64;
}


/* =========================
   TEXT INPUTS
   ========================= */

QLineEdit {
    background-color: #202023;
    color: #dddddf;
    border: none;
    border-radius: 5px;
    padding: 8px;
}

QLineEdit:hover {
    background-color: #29292d;
}

QLineEdit:focus {
    background-color: #2c2c30;
}

QTextEdit,
QPlainTextEdit {
    background-color: #202023;
    color: #dddddf;
    border: none;
    border-radius: 5px;
    padding: 8px;
}

QTextEdit:focus,
QPlainTextEdit:focus {
    background-color: #29292d;
}


/* =========================
   COMBO BOX
   ========================= */

QComboBox {
    background-color: #222225;
    color: #d7d7da;
    border: none;
    border-radius: 5px;
    padding: 8px;
}

QComboBox:hover {
    background-color: #2c2c30;
}

QComboBox QAbstractItemView {
    background-color: #222225;
    color: #d7d7da;
    border: none;
    selection-background-color: #582b2b;
}


/* =========================
   LISTS
   ========================= */

QListWidget {
    background-color: #1b1b1e;
    color: #d7d7da;
    border: none;
    border-radius: 5px;
}

QListWidget::item {
    padding: 9px;
}

QListWidget::item:hover {
    background-color: #29292d;
}

QListWidget::item:selected {
    background-color: #582b2b;
    color: #ffffff;
}


/* =========================
   TABLES
   ========================= */

QTableWidget,
QTableView {
    background-color: #1b1b1e;
    color: #d7d7da;
    border: none;
    gridline-color: #29292d;
    alternate-background-color: #202023;
}

QTableWidget::item:selected,
QTableView::item:selected {
    background-color: #582b2b;
    color: #ffffff;
}

QHeaderView::section {
    background-color: #252528;
    color: #aaaaaf;
    border: none;
    padding: 8px;
}


/* =========================
   TABS
   ========================= */

QTabWidget::pane {
    background-color: #1b1b1e;
    border: none;
}

QTabBar::tab {
    background-color: #202023;
    color: #88888e;
    border: none;
    padding: 8px 14px;
}

QTabBar::tab:hover {
    background-color: #2b2b2f;
    color: #eeeeef;
}

QTabBar::tab:selected {
    background-color: #582b2b;
    color: #f27b7b;
}


/* =========================
   CHECKBOXES
   ========================= */

QCheckBox {
    background-color: transparent;
    color: #d5d5d8;
    spacing: 7px;
}

QCheckBox::indicator {
    width: 15px;
    height: 15px;
}

QCheckBox::indicator:unchecked {
    background-color: #252528;
    border: none;
    border-radius: 3px;
}

QCheckBox::indicator:checked {
    background-color: #bd4545;
    border: none;
    border-radius: 3px;
}


/* =========================
   DATE / TIME
   ========================= */

QDateEdit,
QTimeEdit,
QDateTimeEdit {
    background-color: #202023;
    color: #dddddf;
    border: none;
    border-radius: 5px;
    padding: 8px;
}

QDateEdit:focus,
QTimeEdit:focus,
QDateTimeEdit:focus {
    background-color: #2c2c30;
}


/* =========================
   SPIN BOXES
   ========================= */

QSpinBox,
QDoubleSpinBox {
    background-color: #202023;
    color: #dddddf;
    border: none;
    border-radius: 5px;
    padding: 8px;
}

QSpinBox:focus,
QDoubleSpinBox:focus {
    background-color: #2c2c30;
}


/* =========================
   MENUS
   ========================= */

QMenuBar {
    background-color: #18181b;
    color: #c5c5c9;
    border: none;
}

QMenuBar::item {
    padding: 7px 10px;
}

QMenuBar::item:selected {
    background-color: #29292d;
    color: #ffffff;
}

QMenu {
    background-color: #202023;
    color: #d7d7da;
    border: none;
}

QMenu::item {
    padding: 8px 20px;
}

QMenu::item:selected {
    background-color: #582b2b;
    color: #ffffff;
}


/* =========================
   SCROLL BARS
   ========================= */

QScrollBar:vertical {
    background-color: #141416;
    width: 10px;
    border: none;
}

QScrollBar::handle:vertical {
    background-color: #3a3a3e;
    border-radius: 5px;
    min-height: 25px;
}

QScrollBar::handle:vertical:hover {
    background-color: #823a3a;
}

QScrollBar:horizontal {
    background-color: #141416;
    height: 10px;
    border: none;
}

QScrollBar::handle:horizontal {
    background-color: #3a3a3e;
    border-radius: 5px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #823a3a;
}


/* =========================
   PROGRESS BAR
   ========================= */

QProgressBar {
    background-color: #232326;
    color: #e5e5e7;
    border: none;
    border-radius: 5px;
    text-align: center;
}

QProgressBar::chunk {
    background-color: #bd4545;
    border-radius: 5px;
}


/* =========================
   TOOL TIPS
   ========================= */

QToolTip {
    background-color: #29292d;
    color: #eeeeef;
    border: none;
    padding: 6px;
}
</string>
